{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowttl/az-axi/axi-credential.schema.json",
  "title": "az-axi credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth"],
  "properties": {
    "auth": { "enum": ["az", "token"] },
    "tenantId": { "type": "string" },
    "managementGroup": { "type": "string" },
    "subscriptions": { "type": "array", "items": { "type": "string" } },
    "workspaces": { "type": "object", "additionalProperties": { "type": "string" } },
    "description": { "type": "string" },
    "allowWrites": { "type": "boolean", "default": false },
    "armToken": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "AZ_AXI_ARM_TOKEN" } },
    "logsToken": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "AZ_AXI_LOGS_TOKEN" } },
    "graphToken": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "AZ_AXI_GRAPH_TOKEN" } },
    "storageToken": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "AZ_AXI_STORAGE_TOKEN" } },
    "vaultToken": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "AZ_AXI_VAULT_TOKEN" } },
    "registryToken": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "AZ_AXI_REGISTRY_TOKEN" } },
    "tokenEnv": {
      "type": "object",
      "deprecated": true,
      "description": "Deprecated for one minor release; use the resource Token SecretRef fields.",
      "propertyNames": { "enum": ["arm", "logs", "graph", "storage", "vault", "registry"] },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    }
  },
  "allOf": [
    { "if": { "properties": { "allowWrites": { "const": true } }, "required": ["allowWrites"] },
      "then": { "required": ["subscriptions"], "properties": { "subscriptions": { "minItems": 1 } } } },
    { "not": { "required": ["armToken", "tokenEnv"], "properties": { "tokenEnv": { "required": ["arm"] } } } },
    { "not": { "required": ["logsToken", "tokenEnv"], "properties": { "tokenEnv": { "required": ["logs"] } } } },
    { "not": { "required": ["graphToken", "tokenEnv"], "properties": { "tokenEnv": { "required": ["graph"] } } } },
    { "not": { "required": ["storageToken", "tokenEnv"], "properties": { "tokenEnv": { "required": ["storage"] } } } },
    { "not": { "required": ["vaultToken", "tokenEnv"], "properties": { "tokenEnv": { "required": ["vault"] } } } },
    { "not": { "required": ["registryToken", "tokenEnv"], "properties": { "tokenEnv": { "required": ["registry"] } } } }
  ],
  "$defs": {
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])", "description": "Absolute local path; Windows accepts drive paths only, never UNC or device paths." } } },
        { "type": "object", "additionalProperties": false, "required": ["stored"], "properties": { "stored": { "const": true } }, "description": "Structurally valid SecretRef; az-axi does not store credentials and reports AUTH_REQUIRED." }
      ]
    }
  }
}
