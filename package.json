{
  "name": "@knowttl/az-axi",
  "version": "0.0.0",
  "description": "Agent-ergonomic CLI for Azure, read-only by default. Resource inventory, RBAC, activity log, Defender for Cloud and Log Analytics through token-efficient TOON output. An AXI (Agent eXperience Interface) over the Azure REST APIs.",
  "keywords": [
    "azure",
    "axi",
    "agent",
    "cli",
    "toon",
    "resource-graph",
    "defender-for-cloud",
    "log-analytics"
  ],
  "license": "MIT",
  "author": "knowttl",
  "homepage": "https://github.com/knowttl/az-axi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/az-axi.git"
  },
  "bugs": {
    "url": "https://github.com/knowttl/az-axi/issues"
  },
  "type": "module",
  "bin": {
    "az-axi": "dist/bin/az-axi.js"
  },
  "files": [
    "dist",
    "skills/az-axi",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin/az-axi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.0",
    "axi-sdk-js": "^0.1.7",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "20.19.43",
    "gpt-tokenizer": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  }
}
