{
  "name": "@knowttl/az-axi",
  "version": "0.1.17",
  "description": "Agent-ergonomic CLI for Azure, read-only by default. Resource inventory, RBAC, activity log, Defender for Cloud and Log Analytics through token-efficient TOON output. An AXI (Agent eXperience Interface) over the Azure REST APIs.",
  "keywords": [
    "azure",
    "axi",
    "agent",
    "cli",
    "toon",
    "resource-graph",
    "defender-for-cloud",
    "log-analytics"
  ],
  "license": "MIT",
  "author": "knowttl",
  "homepage": "https://github.com/knowttl/az-axi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/az-axi.git"
  },
  "bugs": {
    "url": "https://github.com/knowttl/az-axi/issues"
  },
  "type": "module",
  "bin": {
    "az-axi": "dist/bin/az-axi.js",
    "az-axi-hook": "dist/bin/az-axi-hook.js",
    "az-axi-guard": "scripts/claude-guard.mjs"
  },
  "files": [
    "dist",
    "scripts/claude-guard.mjs",
    "axi-credential.schema.json",
    "skills/az-axi",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "lint": "tsc --noEmit && tsc -p tsconfig.tooling.json",
    "catalogue:generate": "node scripts/az-read-catalogue.ts",
    "catalogue:check": "node scripts/az-read-catalogue.ts --check",
    "skill:generate": "npm run build && node scripts/skill.ts",
    "skill:check": "npm run build && node scripts/skill.ts --check",
    "dev": "tsx src/bin/az-axi.ts",
    "test": "node scripts/isolated-run.mjs node_modules/.bin/vitest run",
    "test:watch": "node scripts/isolated-run.mjs node_modules/.bin/vitest",
    "bench": "node scripts/benchmark/bench.ts",
    "bench:capture": "node scripts/benchmark/capture.ts",
    "bench:surface": "node scripts/benchmark/capture-surface.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@kusto/language-service-next": "^12.4.1",
    "@toon-format/toon": "^4.4.0",
    "axi-sdk-js": "^0.1.7",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "26.6.5",
    "gpt-tokenizer": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
